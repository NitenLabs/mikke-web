{
  "name": "@mikke/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply mikke --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env prod",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run --env dev && wrangler deploy --dry-run --outdir .wrangler/dry-run --env prod",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
